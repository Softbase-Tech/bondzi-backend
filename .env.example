# =============================================================================
# PassMaster Ghana — Backend Environment Variables
# Copy to .env and fill with real values. Never commit .env.
# Server refuses to start if any REQUIRED variable is missing or malformed
# (see src/config/validation.schema.ts for the Joi schema and defaults).
# Variables with defaults are optional — listed here so operators know what
# they can tune.
# =============================================================================

# --- Application ---------------------------------------------------------------
NODE_ENV=development
PORT=9000
API_PREFIX=api/v1
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:19006

# Gates BullMQ processors + @Cron handlers. Must be the literal string
# "true" — "True" / "1" / any other truthy-looking value fails validation
# at boot so a typo doesn't leave the api container running every cron
# in parallel with the worker.
WORKER_MODE=false

# --- Database (PostgreSQL 15+) -------------------------------------------------
DATABASE_URL=postgresql://passmaster:passmaster@localhost:5432/passmaster
DATABASE_SSL=false
DATABASE_LOGGING=false
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20

# --- Redis 7+ -----------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_TLS=false

# --- JWT ----------------------------------------------------------------------
JWT_ACCESS_SECRET=change_me_to_64_char_random_hex_access
JWT_REFRESH_SECRET=change_me_to_64_char_random_hex_refresh_different
JWT_ACCESS_EXPIRY=15m
# Refresh token lifetime = effective "stay signed in" window. Access
# tokens rotate every 15m automatically; only the refresh matters for
# session persistence.
JWT_REFRESH_EXPIRY=90d

# --- Paystack (Ghana) ---------------------------------------------------------
PAYSTACK_SECRET_KEY_GH=sk_test_xxx
PAYSTACK_PUBLIC_KEY_GH=pk_test_xxx
PAYSTACK_WEBHOOK_SECRET=change_me
PAYSTACK_CALLBACK_URL=https://app.passmaster.com.gh/payments/callback
# After a plan price change, the previous plan stays resolvable for this
# many hours so any open Paystack authorizationUrl can still complete
# checkout against v1. Paystack's URL TTL is typically ~24h.
CHECKOUT_GRACE_HOURS=48

# --- AI — Bedrock-hosted Anthropic Claude -------------------------------------
# Auth is via the AWS SDK chain (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
# below, or an EC2/Lightsail IAM role). There is no per-provider API key.
# Preferred model keys — used by ai.config.ts.
# Cross-region inference profile IDs (geo-prefixed). Bedrock rejects the
# bare `anthropic.*` model ID for on-demand invocation of these models.
# `eu.` matches AWS_REGION=eu-central-1 below; use `us.` for us-* regions.
AI_QUALITY_MODEL=eu.anthropic.claude-sonnet-4-5-20250929-v1:0
AI_DEFAULT_MODEL=eu.anthropic.claude-haiku-4-5-20251001-v1:0
# Legacy fallbacks — set only if you're pinning to older names. Empty
# means "use AI_QUALITY_MODEL / AI_DEFAULT_MODEL above".
AI_EXPLANATION_MODEL=
AI_FAST_MODEL=

# Daily spend guardrails.
AI_DAILY_BUDGET_USD=50
AI_PER_USER_DAILY_LIMIT=50
# Per-job cost ceiling. A batch whose ACTUAL running cost exceeds this
# aborts mid-flight rather than running to completion.
AI_MAX_JOB_COST_USD=500
# Jobs whose ESTIMATED cost exceeds this land in PENDING_APPROVAL and
# require a second admin to approve before enqueue. Defends against a
# single compromised admin session draining budget in one click. Set to
# 0 to disable co-sign entirely.
AI_COSIGN_THRESHOLD_USD=50
# Bedrock SDK-level retry attempts on throttling / 5xx.
AI_BEDROCK_MAX_RETRIES=3
# Client-side requests-per-minute ceiling for Bedrock. The worker paces bulk
# generation to stay under this so it doesn't trip Bedrock's account-level RPM
# quota. Set it to the RPM AWS has *granted* you (Service Quotas → Bedrock →
# "Cross-region requests per minute"), leaving ~20% headroom. Default 10 matches
# a fresh account's initial grant.
AI_BEDROCK_MAX_RPM=10
# Row-count backstop for admin generation batches — fires BEFORE
# enqueue on either provider. Matters most on the Ollama path where
# AI_MAX_JOB_COST_USD is meaningless ($0 local cost).
AI_MAX_ITEMS_PER_BATCH=1000
# Per-request Bedrock socket timeout. Default 120000 — a 10-question
# quantitative batch takes 60–90s of non-streamed generation, so the
# old 30s ceiling aborted large batches at the transport layer.
AI_BEDROCK_REQUEST_TIMEOUT_MS=120000
# Blind second-pass answer verification on generated questions
# (one Haiku call per item; disagreements land in the review queue
# marked key_mismatch instead of publishing). 'false' disables.
AI_ANSWER_VERIFIER_ENABLED=true
# Serve system shells from the prompt_templates table (hot-swappable,
# versioned) instead of the compiled instruction layer. Off by default;
# run `npm run seed:prompts` first so the DB rows match the code.
AI_PROMPT_TEMPLATES_ENABLED=false
# Nightly golden-set evaluation (02:00 UTC on the worker): key-agreement,
# explanation-contract pass rate, LLM-judge scores → ai_eval_runs +
# ADMIN_ALERT_EMAIL. ~USD 0.02/night on Haiku at the default sample.
# Off by default — enabling nightly spend is a deliberate act.
AI_EVAL_ENABLED=false
AI_EVAL_SAMPLE=12
# Weekly item calibration from live student answers (pure SQL, $0):
# writes irt_difficulty and pulls bad-key-shaped items to review.
# On by default; 'false' disables.
AI_ITEM_CALIBRATION_ENABLED=true

# Generation provider. `bedrock` (default) uses AWS Bedrock via the
# standard AWS SDK auth chain. `self_hosted` routes admin batch
# generation through OllamaClient at OLLAMA_BASE_URL — question +
# explanation generation only. Weakness narratives + post-exam
# breakdowns stay pinned to Bedrock regardless.
AI_PROVIDER=bedrock
# Required ONLY when AI_PROVIDER=self_hosted. Ignored under Bedrock.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M
# 120s covers a 1k-token generation on a CPU-only 8B model with headroom.
# A GPU box needs 15-30s, but the ceiling doesn't hurt.
OLLAMA_REQUEST_TIMEOUT_MS=120000

# --- Africa's Talking (SMS OTP) -----------------------------------------------
AT_USERNAME=sandbox
AT_API_KEY=atsk_xxx
AT_SENDER_ID=BONDZI

# --- AWS (Bedrock + S3 storage) -----------------------------------------------
# Same credentials serve Bedrock (AI) and S3 (media). In production use an
# IAM role; the SDK's default credential chain picks it up automatically.
AWS_S3_BUCKET=passmaster-media
AWS_ACCESS_KEY_ID=xxx
AWS_SECRET_ACCESS_KEY=xxx
AWS_REGION=eu-central-1
AWS_S3_PUBLIC_BASE_URL=https://passmaster-media.s3.eu-central-1.amazonaws.com

# --- Firebase (push) ----------------------------------------------------------
# All three empty = Firebase disabled; push sends silently no-op.
FIREBASE_PROJECT_ID=passmaster-ghana
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@passmaster-ghana.iam.gserviceaccount.com

# --- Email (Resend) -----------------------------------------------------------
# Required in production when MAIL_ENABLED=true. Non-prod deploys can
# leave RESEND_API_KEY empty and mail sends will no-op.
MAIL_ENABLED=true
RESEND_API_KEY=re_xxx
MAIL_FROM="Bondzi <noreply@bondzi.online>"
MAIL_REPLY_TO=info@bondzi.online
MAIL_WEB_URL=https://bondzi.online
RESEND_WEBHOOK_SECRET=whsec_xxx
# Comma-separated inboxes that get the weekly "select winners" reminder.
# Empty string disables the reminder send.
WINNER_REMINDER_RECIPIENTS=ekow@bondzi.online,info@bondzi.online
# Hard per-run cap on study-reminder fallback emails (sent ONLY to users
# with no push-capable device, at most every 3rd day per user). This is
# the cost ceiling: cap × ~10 runs/month per user cohort stays far under
# Resend's 3k/month free tier. 0 disables the email fallback entirely.
REENGAGEMENT_EMAIL_DAILY_CAP=150
# Click-through URL for browser (web) push notifications. Defaults to
# MAIL_WEB_URL / APP_URL when unset.
WEB_PUSH_CLICK_URL=https://bondzi.online

# --- Google OAuth -------------------------------------------------------------
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com

# --- Monitoring ---------------------------------------------------------------
SENTRY_DSN=
ADMIN_ALERT_EMAIL=admin@passmaster.com.gh

# --- Initial superadmin (seed:admin only) -------------------------------------
# In production SEED_ADMIN_PASSWORD must be ≥16 chars and cannot use the
# public default — Joi hard-fails at boot otherwise.
SEED_ADMIN_EMAIL=admin@passmaster.com.gh
SEED_ADMIN_PASSWORD=change_me_strong_16_chars_min_here
SEED_ADMIN_NAME=Platform Admin

# --- Throttler ----------------------------------------------------------------
THROTTLE_SHORT_LIMIT=30
THROTTLE_SHORT_TTL=10
THROTTLE_LONG_LIMIT=200
THROTTLE_LONG_TTL=60

# --- Subscriptions ------------------------------------------------------------
# SubscriptionGuard's Redis cache TTL in seconds. Lower = less staleness
# after a cancel/refund; higher = fewer DB hits on the protected path.
# Range 10..600. Default 60 is the sweet spot for an 8k-DAU service.
SUBSCRIPTION_STATUS_CACHE_TTL=60

# --- Ads ----------------------------------------------------------------------
# Rewarded-ad XP path. Keep OFF until AdMob server-side verification is
# wired — the current implementation would trust the client's "I watched
# an ad" call, so a curl loop could mint XP up to the daily frequency cap.
ADS_REWARDED_XP_ENABLED=false

# --- Observability ------------------------------------------------------------
LOG_LEVEL=info
# Grafana Cloud Loki shipping. All three empty = logs stay on stdout only.
LOKI_URL=
LOKI_USER=
LOKI_API_KEY=
# /api/v1/internal/metrics is behind a static bearer token AND an nginx
# IP allowlist. Enabled by default; the token only needs to be set in prod.
METRICS_ENABLED=true
METRICS_BEARER_TOKEN=
