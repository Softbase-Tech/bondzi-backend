# =============================================================================
# PassMaster Ghana — Backend Environment Variables
# Copy to .env and fill with real values. Never commit .env.
# Server refuses to start if any required variable is missing (Joi schema).
# =============================================================================

# --- Application ---------------------------------------------------------------
NODE_ENV=development
PORT=9000
API_PREFIX=api/v1
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:19006

# --- Database (PostgreSQL 15+) -------------------------------------------------
DATABASE_URL=postgresql://passmaster:passmaster@localhost:5432/passmaster
DATABASE_SSL=false
DATABASE_LOGGING=false
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20

# --- Redis 7+ -----------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_TLS=false

# --- JWT ----------------------------------------------------------------------
JWT_ACCESS_SECRET=change_me_to_64_char_random_hex_access
JWT_REFRESH_SECRET=change_me_to_64_char_random_hex_refresh_different
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# --- Paystack (Ghana) ---------------------------------------------------------
PAYSTACK_SECRET_KEY_GH=sk_test_xxx
PAYSTACK_PUBLIC_KEY_GH=pk_test_xxx
PAYSTACK_WEBHOOK_SECRET=change_me
PAYSTACK_PLAN_MONTHLY_GH=PLN_monthly_xxx
PAYSTACK_PLAN_TERMLY_GH=PLN_termly_xxx
PAYSTACK_PLAN_ANNUAL_GH=PLN_annual_xxx
PAYSTACK_CALLBACK_URL=https://app.passmaster.com.gh/payments/callback

# --- AI -----------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxx
OPENAI_API_KEY=sk-xxx
AI_EXPLANATION_MODEL=claude-sonnet-4-6
AI_FAST_MODEL=claude-haiku-4-5-20251001
AI_FAILOVER_MODEL=gpt-4o-mini
AI_DAILY_BUDGET_USD=50
AI_PER_USER_DAILY_LIMIT=50

# --- Africa's Talking (SMS OTP) -----------------------------------------------
AT_USERNAME=sandbox
AT_API_KEY=atsk_xxx
AT_SENDER_ID=PASSMASTER

# --- Storage (S3-compatible) --------------------------------------------------
AWS_S3_BUCKET=passmaster-media
AWS_ACCESS_KEY_ID=xxx
AWS_SECRET_ACCESS_KEY=xxx
AWS_REGION=af-south-1
AWS_S3_PUBLIC_BASE_URL=https://passmaster-media.s3.af-south-1.amazonaws.com

# --- Firebase (push) ----------------------------------------------------------
FIREBASE_PROJECT_ID=passmaster-ghana
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@passmaster-ghana.iam.gserviceaccount.com

# --- Email (Brevo / Sendinblue) -----------------------------------------------
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=noreply@passmaster.com.gh
SMTP_PASSWORD=xxx
SMTP_FROM="PassMaster Ghana <noreply@passmaster.com.gh>"

# --- Google OAuth -------------------------------------------------------------
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com

# --- Monitoring ---------------------------------------------------------------
SENTRY_DSN=
ADMIN_ALERT_EMAIL=admin@passmaster.com.gh

# --- Initial superadmin (used by seed:admin only) -----------------------------
SEED_ADMIN_EMAIL=admin@passmaster.com.gh
SEED_ADMIN_PASSWORD=change_me_strong
SEED_ADMIN_NAME=Platform Admin

# --- Throttler ----------------------------------------------------------------
THROTTLE_SHORT_LIMIT=30
THROTTLE_SHORT_TTL=10
THROTTLE_LONG_LIMIT=200
THROTTLE_LONG_TTL=60
