# Copy to /opt/bondzi/.env and fill in the <placeholders>.
# After filling in:  chmod 600 /opt/bondzi/.env
#
# Generate the random values with:
#   openssl rand -hex 24   # postgres password
#   openssl rand -hex 24   # redis password
#   openssl rand -hex 32   # jwt access secret
#   openssl rand -hex 32   # jwt refresh secret (must differ from access)

NODE_ENV=production
PORT=3000

# === Postgres ===
# `postgres` is the docker-compose service name; the api/worker containers
# resolve it on the default bridge network.
POSTGRES_USER=bondzi
POSTGRES_PASSWORD=<openssl rand -hex 24>
POSTGRES_DB=bondzi_prod
DATABASE_URL=postgresql://bondzi:<same-password>@postgres:5432/bondzi_prod

# === Redis ===
REDIS_URL=redis://:<redis-password>@redis:6379
REDIS_PASSWORD=<openssl rand -hex 24>

# === JWT ===
JWT_ACCESS_SECRET=<openssl rand -hex 32>
JWT_REFRESH_SECRET=<openssl rand -hex 32>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# === AWS — Bedrock for AI inference, S3 for assets and backups ===
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
AWS_S3_BUCKET=bondzi-prod
AWS_S3_REGION=eu-central-1

# Bedrock model IDs (anthropic.<name>-v1:0 form).
AI_DEFAULT_MODEL=anthropic.claude-haiku-4-5-20251001-v1:0
AI_QUALITY_MODEL=anthropic.claude-sonnet-4-5-20250929-v1:0
AI_MAX_JOB_COST_USD=500
AI_DAILY_BUDGET_USD=50
AI_PER_USER_DAILY_LIMIT=50
AI_BEDROCK_MAX_RETRIES=3
# Row-count ceiling on admin generation batches. Fires BEFORE enqueue.
AI_MAX_ITEMS_PER_BATCH=200
# Prod defaults to `bedrock`. Set `self_hosted` on a worker that
# runs its own Ollama instance (local dev / cost-avoidance batches).
# Question + explanation generation flip via this switch; weakness
# narratives + post-exam breakdowns (when built) stay on Bedrock
# regardless — factory pins those directly.
AI_PROVIDER=bedrock
# Only consulted when AI_PROVIDER=self_hosted.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M
# OLLAMA_REQUEST_TIMEOUT_MS=120000

# === Paystack ===
PAYSTACK_SECRET_KEY_GH=sk_live_...
PAYSTACK_WEBHOOK_SECRET=...

# === Africa's Talking SMS ===
# The owner must whitelist this box's static IP in the Africa's Talking
# dashboard before SMS sending will work.
AT_USERNAME=bondzi
AT_API_KEY=...

# === Firebase Admin (push notifications) ===
FIREBASE_PROJECT_ID=...
# Newlines must be escaped as \n inside the env value.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=...

# === Resend (transactional email) ===
MAIL_ENABLED=true
RESEND_API_KEY=re_...
MAIL_FROM="Bondzi <noreply@bondzi.online>"
MAIL_REPLY_TO=support@bondzi.online
MAIL_WEB_URL=https://bondzi.online
RESEND_WEBHOOK_SECRET=whsec_...
# Comma-separated inboxes for the weekly "select winners" reminder.
WINNER_REMINDER_RECIPIENTS=ekow@bondzi.online,info@bondzi.online

# === Sentry ===
SENTRY_DSN=https://...@sentry.io/...

# === CORS ===
# Comma-separated list of origins that may call this API. Include the admin
# dashboard and the mobile app's deep-link scheme if relevant.
CORS_ORIGINS=https://admin.bondzi.online,https://bondzi.online
